{
  "name": "@laflabs/lafetch",
  "version": "0.3.1-alpha.0",
  "description": "A data-first TypeScript HTTP client with readable reliability policies.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./feature": {
      "types": "./dist/feature.d.ts",
      "import": "./dist/feature.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:worker": "vitest run tests/worker-runtime.test.ts",
    "test:next": "pnpm build && pnpm --filter @laflabs/lafetch-next-fixture build",
    "test:package": "node scripts/verify-package.mjs",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:package",
    "check:runtimes": "pnpm test:browser && pnpm test:worker && pnpm test:next"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "esbuild": "^0.28.1",
    "miniflare": "^4.20260710.0",
    "next": "^16.2.10",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "7.0.2",
    "valibot": "^1.4.2",
    "vitest": "4.1.10",
    "zod": "^4.4.3"
  }
}
